# Variables de build. Copier en `.env.local` pour un usage en développement.
# Le déploiement, lui, les reçoit depuis .github/workflows/deploy.yml.

# Conteneur Google Tag Manager. Laissé vide, aucun script de mesure n'est
# injecté : un `npm run dev` ne pollue donc pas les statistiques de production.
# Le renseigner localement pour tester avec l'aperçu GTM (Tag Assistant).
NEXT_PUBLIC_GTM_ID=

# Sous-chemin de publication. Vide pour un domaine à la racine (a7emailing.com),
# "/A7" pour la GitHub Page projet digitalforbiness.github.io/A7.
NEXT_PUBLIC_BASE_PATH=
